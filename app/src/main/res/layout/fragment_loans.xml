<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/loan_management"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#9C27B0"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:id="@+id/loanHeaderAdminArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:padding="12dp"
        android:elevation="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/record_new_loan"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/imgArrowLoan"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_more"
            android:rotation="0"
            android:contentDescription="@string/record_new_loan"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loanAdminInputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:padding="12dp"
        android:elevation="2dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/loanBorrowerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/borrower_name"
            android:inputType="textPersonName"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/loanBorrowerPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/borrower_phone"
            android:inputType="phone"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/loanAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/loan_amount"
            android:inputType="numberDecimal"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/loanDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/loan_details"
            android:inputType="textMultiLine"
            android:importantForAutofill="no"/>

        <Button
            android:id="@+id/btnSaveLoan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_loan_record"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <EditText
        android:id="@+id/loanSearchBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_borrower_hint"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:background="@android:drawable/editbox_background"
        android:inputType="text"
        android:importantForAutofill="no"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/loanRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"/>

</LinearLayout>
