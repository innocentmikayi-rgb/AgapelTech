<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_alignParentTop="true">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/logo_agapel"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/logo_description"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:weightSum="5">

        <LinearLayout
            android:id="@+id/nav_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@string/nav_home" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_home"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_products"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_products"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@string/nav_products" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_products"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_sales"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sales"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@string/nav_sales" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_sales"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_reports"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_reports"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@string/nav_reports" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_reports"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_more"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_more"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="@string/nav_more" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nav_more"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottom_navigation_bar"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/logo_agapel"
            android:layout_gravity="center"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/logo_description"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/business_dashboard"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0D3B84"
            android:layout_marginBottom="16dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Net Profit Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorPrimary"
                    android:padding="20dp"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/estimated_net_profit_month"
                        android:textColor="?attr/colorOnPrimary"
                        android:alpha="0.7"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/txtDashNetProfit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ugx_0"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2">

                    <!-- Gross Sales -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="?attr/colorSurface"
                        android:padding="16dp"
                        android:layout_margin="4dp"
                        android:orientation="vertical"
                        android:elevation="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/gross_sales"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/txtDashGrossSales"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />
                    </LinearLayout>

                    <!-- Total Expenses -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="?attr/colorSurface"
                        android:padding="16dp"
                        android:layout_margin="4dp"
                        android:orientation="vertical"
                        android:elevation="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/expenses"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/txtDashExpenses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:textStyle="bold"
                            android:textColor="@color/error_red" />
                    </LinearLayout>

                    <!-- Total Debt -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="?attr/colorSurface"
                        android:padding="16dp"
                        android:layout_margin="4dp"
                        android:orientation="vertical"
                        android:elevation="2dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_debt"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/txtDashDebt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:textStyle="bold"
                            android:textColor="@color/warning_orange" />
                    </LinearLayout>

                    <!-- Comparison Metrics -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="?attr/colorSurface"
                        android:padding="16dp"
                        android:layout_margin="4dp"
                        android:orientation="vertical"
                        android:elevation="2dp">
                        <TextView
                            android:id="@+id/txtComparisonTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/growth_info"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/txtComparisonValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/calculated"
                            android:textStyle="bold"
                            android:textColor="@color/success_green"
                            android:textSize="12sp" />
                    </LinearLayout>
                </GridLayout>

                <!-- Analytics Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurface"
                    android:padding="16dp"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/txtGraphTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weekly_sales_performance"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="12dp"/>

                    <RadioGroup
                        android:id="@+id/rgGraphRange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">
                        <RadioButton
                            android:id="@+id/rbWeekly"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/weekly"
                            android:checked="true"
                            android:textSize="11sp" />
                        <RadioButton
                            android:id="@+id/rbMonthly"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/monthly"
                            android:textSize="11sp" />
                        <RadioButton
                            android:id="@+id/rbQuarterly"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/quarterly"
                            android:textSize="11sp" />
                        <RadioButton
                            android:id="@+id/rbYearly"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/yearly"
                            android:textSize="11sp" />
                    </RadioGroup>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/salesLineChart"
                        android:layout_width="match_parent"
                        android:layout_height="200dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/txtWeeklyGrowth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/weekly_growth_placeholder"
                            android:textColor="@color/success_green"
                            android:textStyle="bold"
                            android:textSize="12sp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Profit/Expense Analysis -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorSurface"
                    android:padding="16dp"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:elevation="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profit_vs_expenses_monthly"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="12dp"/>

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/dashProfitPieChart"
                        android:layout_width="match_parent"
                        android:layout_height="250dp" />
                </LinearLayout>

                <!-- Low Stock Alert Section -->
                <LinearLayout
                    android:id="@+id/layoutLowStockAlert"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/low_stock_bg"
                    android:padding="16dp"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:elevation="2dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/low_stock_alerts"
                        android:textStyle="bold"
                        android:textColor="#E65100"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/txtLowStockItems"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading..."
                        android:textColor="#BF360C"
                        android:textSize="12sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_actions"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnQuickExpense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/record_new_expense"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                <Button
                    android:id="@+id/btnQuickDebt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/view_debtors_list"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout_products_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottom_navigation_bar"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/adminInputArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="?attr/colorSurfaceVariant"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_add_edit_product"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/itemName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/item_name_hint"
                    android:autofillHints="name"
                    android:inputType="textPersonName" />
                <ImageButton
                    android:id="@+id/btnScanAdmin"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_scan"
                    android:background="?attr/selectableItemBackground"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@string/type_to_search_or_scan_hint" />
            </LinearLayout>

            <EditText
                android:id="@+id/buyingPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/buying_price_hint"
                android:inputType="numberDecimal"
                android:autofillHints="none" />

            <EditText
                android:id="@+id/sellingPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/selling_price_hint"
                android:inputType="numberDecimal"
                android:autofillHints="none" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">
                <EditText
                    android:id="@+id/itemQty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/stock_quantity_hint"
                    android:inputType="number"
                    android:autofillHints="none" />
                <EditText
                    android:id="@+id/lowStockThreshold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/low_stock_threshold_hint"
                    android:inputType="number"
                    android:autofillHints="none" />
                <Spinner
                    android:id="@+id/itemCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:contentDescription="@string/growth_info" />
            </LinearLayout>

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_item"
                android:background="?attr/colorPrimary"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/product_inventory"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0D3B84"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:background="@drawable/search_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint="@string/search_items_hint"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:textSize="14sp"
                android:autofillHints="none"
                android:inputType="text" />
        </LinearLayout>

        <ListView
            android:id="@+id/listView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/layout_sales_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottom_navigation_bar"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record_new_sale"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/particulars_item_name"
                    android:textStyle="bold"
                    android:textColor="#333333"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <AutoCompleteTextView
                        android:id="@+id/saleParticulars"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/type_to_search_or_scan_hint"
                        android:completionThreshold="1"
                        android:singleLine="true"
                        android:autofillHints="none"
                        android:inputType="text" />
                    <ImageButton
                        android:id="@+id/btnScanSale"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_scan"
                        android:background="?attr/selectableItemBackground"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="@string/type_to_search_or_scan_hint" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/customer_name"
                    android:textStyle="bold"
                    android:textColor="#333333"/>
                <EditText
                    android:id="@+id/saleCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_customer_name_optional_hint"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp"
                    android:autofillHints="name"
                    android:inputType="textPersonName" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/customer_phone"
                    android:textStyle="bold"
                    android:textColor="#333333"/>
                <EditText
                    android:id="@+id/saleCustomerPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_customer_phone_hint"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp"
                    android:autofillHints="phone"
                    android:inputType="phone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/quantity_qty"
                    android:textStyle="bold"
                    android:textColor="#333333"/>
                <EditText
                    android:id="@+id/saleQty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_quantity_hint"
                    android:inputType="number"
                    android:layout_marginBottom="12dp"
                    android:autofillHints="none" />

                <TextView
                    android:id="@+id/txtSaleBPLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buying_price_bp_per_unit"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"/>
                <EditText
                    android:id="@+id/saleBP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/auto_filled_from_inventory_hint"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="12dp"
                    android:autofillHints="none" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/selling_price_sp_per_unit"
                    android:textStyle="bold"
                    android:textColor="#333333"/>
                <EditText
                    android:id="@+id/saleSP"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_selling_price_hint"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="12dp"
                    android:autofillHints="none" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/actual_amount_received_paid"
                    android:textStyle="bold"
                    android:textColor="#333333"/>
                <EditText
                    android:id="@+id/saleActualAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enter_actual_cash_collected_hint"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="12dp"
                    android:autofillHints="none" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="?attr/colorSurfaceVariant"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"
                    android:baselineAligned="false"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/actual_profit"
                            android:textSize="12sp"
                            android:textColor="#555555"/>
                        <TextView
                            android:id="@+id/txtLiveProfit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ugx_0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#2E7D32"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/credit_balance"
                            android:textSize="12sp"
                            android:textColor="#555555"/>
                        <TextView
                            android:id="@+id/txtLiveBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ugx_0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#C62828"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btnSaveSale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/colorPrimary"
                    android:text="@string/submit_transaction_log"
                    android:textColor="?attr/colorOnPrimary"
                    android:textStyle="bold"
                    android:padding="12dp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/layout_reports_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottom_navigation_bar"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/daily_reports"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0D3B84"/>

            <Button
                android:id="@+id/btnExportPdf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pdf"
                android:backgroundTint="#D32F2F"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnExportExcel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/excel"
                android:backgroundTint="#1B5E20"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnShareReport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share"
                android:backgroundTint="#2E7D32"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Daily Summary Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E9EFF8"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:weightSum="3">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_sales_caps"
                    android:textSize="12sp"
                    android:textColor="#555555"/>
                <TextView
                    android:id="@+id/txtReportTotalSales"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0D3B84"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutReportProfit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profit_caps"
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"/>
                <TextView
                    android:id="@+id/txtReportTotalProfit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/credit_caps"
                    android:textSize="12sp"
                    android:textColor="#555555"/>
                <TextView
                    android:id="@+id/txtReportTotalCredit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zero"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#C62828"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Profit by Category Chart -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="?attr/colorSurface"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:elevation="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profit_by_category"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_marginBottom="8dp"/>
            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/profitPieChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <ListView
            android:id="@+id/salesListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="#E0E0E0"
            android:dividerHeight="1dp"
            android:scrollbars="none"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_more_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottom_navigation_bar"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_tools"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0D3B84"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/adminLoginBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_login"
            android:backgroundTint="#0D3B84"
            android:textColor="?attr/colorOnPrimary"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnManageExpenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manage_expense_records"
            android:backgroundTint="#555555"
            android:textColor="?attr/colorOnPrimary"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSwitchTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/switch_theme"
            android:backgroundTint="#000000"
            android:textColor="?attr/colorOnPrimary"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/check_for_updates"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_version"
            android:textColor="#888888"
            android:textSize="12sp"/>
    </LinearLayout>
</RelativeLayout>
