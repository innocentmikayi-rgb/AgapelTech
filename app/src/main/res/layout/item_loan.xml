<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtLoanBorrower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Borrower Name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtLoanDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/01/2024"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtLoanDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loan for business expansion"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtLoanAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Amt: UGX 100,000"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:layout_marginRight="12dp" />

            <TextView
                android:id="@+id/txtLoanBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bal: UGX 50,000"
                android:textColor="#C62828"
                android:textStyle="bold"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/txtLoanStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="10sp"
                android:background="#9C27B0"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="&gt;"
        android:textColor="#CCCCCC"
        android:textSize="18sp"
        android:layout_marginLeft="8dp" />

</LinearLayout>
